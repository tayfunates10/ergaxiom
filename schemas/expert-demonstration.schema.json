{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ergaxiom.dev/schemas/expert-demonstration.schema.json",
  "title": "Ergaxiom Expert Demonstration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "demonstration_id", "capsule_id", "job_type", "environment", "application", "provenance", "declared_capability_scope", "decision_points"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "demonstration_id": {"type": "string", "minLength": 1},
    "capsule_id": {"type": "string", "minLength": 1},
    "job_type": {"type": "string", "minLength": 1},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "identity"],
      "properties": {
        "mode": {"enum": ["occupational_twin", "isolated_test"]},
        "identity": {"type": "string", "minLength": 1}
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application_id", "version", "identity_digest"],
      "properties": {
        "application_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "identity_digest": {"type": "string", "minLength": 1}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "license", "content_sha256"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "notes": {"type": "string"}
      }
    },
    "declared_capability_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "decision_points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision_id", "preconditions", "observation", "action", "postconditions"],
        "properties": {
          "decision_id": {"type": "string", "minLength": 1},
          "preconditions": {"type": "array", "items": {"type": "string"}},
          "observation": {"type": "string", "minLength": 1},
          "action": {
            "type": "object",
            "additionalProperties": false,
            "required": ["capability", "operation", "parameters"],
            "properties": {
              "capability": {"type": "string", "minLength": 1},
              "operation": {"type": "string", "minLength": 1},
              "parameters": {"type": "object"}
            }
          },
          "postconditions": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
