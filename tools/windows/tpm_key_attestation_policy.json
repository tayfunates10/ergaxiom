{
  "schema_version": "0.1.0",
  "policy_id": "ergaxiom.windows-production-tpm-key-attestation.v1",
  "status": "UNCONFIGURED_FAIL_CLOSED",
  "trust_model": {
    "caller_supplied_trust_roots_allowed": false,
    "self_asserted_verification_flags_allowed": false,
    "manufacturer_root_sha256_allowlist": [],
