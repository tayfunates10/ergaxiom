    "require_sensitive_data_origin": true,
    "require_restricted": false,
    "require_sign_encrypt": true,
    "forbid_exportable_private_material": true
  },
  "acceptance": {
    "software_generated_p256_allowed": false,
    "untrusted_or_unknown_manufacturer_allowed": false,
    "missing_ek_or_ak_chain_allowed": false,
