{
  "canonical_installer": "nsis",
  "license": {
    "owner_decision_status": "APPROVED",
    "spdx_expression": "LicenseRef-Ergaxiom-Proprietary"
  },
  "packaging": {
    "allow_downgrades": false,
    "install_mode": "perMachine",
    "updater_install_mode": "quiet",
    "install_root": "%ProgramFiles%\\Ergaxiom",
    "interrupted_upgrade_recovery": "rerun_same_or_newer_signed_installer",
    "production_state_root": "%ProgramData%\\Ergaxiom",
    "service_manifest": "%ProgramData%\\Ergaxiom\\ProductionSigner\\service-manifest.json",
    "service_name": "ErgaxiomProductionSigner",
    "targets": [
      "nsis"
    ],
    "uninstall_preserves_production_state": true
  },
  "policy_id": "ergaxiom.windows-production-release",
  "schema_version": "0.1.0",
  "shipping_inventory": {
    "installer": {
      "artifact_id": "windows_installer",
      "disposition": "SHIPPED_INSTALLER",
      "filename_glob": "*-setup.exe",
      "format": "NSIS"
    },
    "linked_runtime_inputs": [
      {
        "artifact_id": "windows_uia_client",
        "build_input": "crates/windows-uia-client-runtime",
        "disposition": "LINKED_INTO_DESKTOP"
      },
      {
        "artifact_id": "windows_bridge",
        "build_input": "crates/windows-bridge-runtime",
        "disposition": "LINKED_INTO_DESKTOP"
      },
      {
        "artifact_id": "inkscape_adapter",
        "build_input": "crates/inkscape-adapter-runtime",
        "disposition": "LINKED_RUNTIME"
      }
    ],
    "signed_pe_artifacts": [
      {
        "artifact_id": "desktop",
        "build_input": "apps/desktop/src-tauri",
        "disposition": "SHIPPED_EXECUTABLE",
        "name": "ergaxiom-desktop.exe"
      },
      {
        "artifact_id": "production_signer_service",
        "build_input": "apps/windows-production-signer-service",
        "disposition": "SHIPPED_EXECUTABLE",
        "name": "ergaxiom-windows-production-signer-service.exe"
      }
    ]
  },
  "signing": {
    "certificate_store_location": "CurrentUser",
    "certificate_store_name": "My",
    "code_signing_eku_oid": "1.3.6.1.5.5.7.3.3",
    "digest_algorithm": "SHA256",
    "expected_certificate_sha256": null,
    "expected_subject": null,
    "identity_status": "OWNER_CERTIFICATE_PIN_REQUIRED",
    "reject_self_signed": true,
    "require_online_revocation": true,
    "timestamp_digest_algorithm": "SHA256",
    "timestamp_protocol": "RFC3161",
    "timestamp_url": "https://timestamp.digicert.com"
  }
}
